# Host/IP de bind dos serviços.
# Mantenha 127.0.0.1 para não expor a stack na rede local.
OLLAMA_BIND_HOST=127.0.0.1
OPEN_WEBUI_BIND_HOST=127.0.0.1
SEARXNG_BIND_HOST=127.0.0.1

# Portas publicadas no host.
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3000
SEARXNG_PORT=8080

# Modelo usado pelos comandos auxiliares quando MODEL não for informado.
OLLAMA_MODEL_DEFAULT=qwen2.5-coder:7b

# Autenticação do Open WebUI.
# Recomendado manter true mesmo em localhost.
WEBUI_AUTH=true

# Busca web opcional no Open WebUI via SearXNG.
# Para usar, suba com: make up-web-search
# ENABLE_PERSISTENT_CONFIG=false faz as variaveis abaixo prevalecerem
# sobre configuracoes antigas salvas no volume do Open WebUI.
ENABLE_PERSISTENT_CONFIG=true
# Metadata padrao dos modelos no Open WebUI. O alvo make up-web-search
# define isto automaticamente para ativar web_search por padrao.
DEFAULT_MODEL_METADATA={}
ENABLE_WEB_SEARCH=false
# Desative para modelos locais que recusam gerar consultas de busca.
ENABLE_SEARCH_QUERY_GENERATION=true
WEB_SEARCH_ENGINE=searxng
WEB_SEARCH_RESULT_COUNT=3
WEB_LOADER_CONCURRENT_REQUESTS=5
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
