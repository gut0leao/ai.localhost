#!/usr/bin/env bash
set -euo pipefail

DEFAULT_STACK_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/localhost-ai"
LEGACY_STACK_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/local-coding-ai"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/localhost-ai"
LEGACY_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/local-coding-ai"
STACK_DIR_FILE="${CONFIG_DIR}/stack-dir"
LEGACY_STACK_DIR_FILE="${LEGACY_CONFIG_DIR}/stack-dir"
STACK_DIR="${LOCALHOST_AI_INSTALL_DIR:-${LOCAL_AI_INSTALL_DIR:-}}"
PROJECT_DIR="${PWD}"
CLIENT=""
START_STACK=true
MODEL_OVERRIDE=""
CLIENT_ARGS=()

fail() {
  printf 'Erro: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Assistente local de programação do localhost.ai

Uso:
  localhost.ai --aider [opções do Aider]
  localhost.ai --opencode [opções do OpenCode]
  localhost.ai --project /caminho/do/repositorio [opções]

Opções do ambiente:
  --aider            Abre o Aider.
  --opencode         Abre o OpenCode.
  --project CAMINHO  Abre a ferramenta nesse repositório Git.
  --no-start         Não tenta iniciar a stack antes de abrir a ferramenta.
  -h, --help         Exibe esta ajuda.

As demais opções são encaminhadas à ferramenta selecionada. Por exemplo:
  localhost.ai --message "explique este projeto"
  localhost.ai --model ollama_chat/outro-modelo
EOF
}

show_startup_guide() {
  local model="$1"
  local client_name="$2"

  cat <<EOF
Ambiente local de IA
  Interface web local: https://ai.localhost
  Projeto:       ${PROJECT_DIR}
  Modelo:        ${model}

Atalhos úteis
  Abrir Aider:       localhost.ai --aider
  Abrir OpenCode:    localhost.ai --opencode
  Escolher modelo:   localhost.ai --model <modelo>
  Baixar modelo:     make -C "${STACK_DIR}" pull-model MODEL=<modelo>
  Todas as opções:   localhost.ai --help

Abrindo o ${client_name}...

EOF
}

env_value() {
  local key="$1"
  local env_file="${STACK_DIR}/.env"

  awk -F= -v key="${key}" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "${env_file}"
}

resolve_stack_dir() {
  local script_path
  local repository_root

  if [[ -n "${STACK_DIR}" ]]; then
    return 0
  fi

  script_path="$(readlink -f "${BASH_SOURCE[0]}")"
  repository_root="$(cd "$(dirname "${script_path}")/.." && pwd)"
  if [[ -f "${repository_root}/docker-compose.yml" ]]; then
    STACK_DIR="${repository_root}"
  elif [[ -r "${STACK_DIR_FILE}" ]]; then
    IFS= read -r STACK_DIR <"${STACK_DIR_FILE}"
  elif [[ -r "${LEGACY_STACK_DIR_FILE}" ]]; then
    IFS= read -r STACK_DIR <"${LEGACY_STACK_DIR_FILE}"
  elif [[ -f "${LEGACY_STACK_DIR}/docker-compose.yml" ]]; then
    STACK_DIR="${LEGACY_STACK_DIR}"
  else
    STACK_DIR="${DEFAULT_STACK_DIR}"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --code)
        fail "--code não é necessário; Aider e OpenCode já usam seus modelos de código configurados"
        ;;
      --aider)
        [[ -z "${CLIENT}" || "${CLIENT}" == "aider" ]] \
          || fail "escolha apenas um assistente: --aider ou --opencode"
        CLIENT="aider"
        ;;
      --opencode)
        [[ -z "${CLIENT}" || "${CLIENT}" == "opencode" ]] \
          || fail "escolha apenas um assistente: --aider ou --opencode"
        CLIENT="opencode"
        ;;
      --project)
        [[ $# -ge 2 ]] || fail "--project requer um caminho"
        PROJECT_DIR="$2"
        shift
        ;;
      --no-start)
        START_STACK=false
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --model)
        [[ $# -ge 2 ]] || fail "--model requer um modelo"
        MODEL_OVERRIDE="$2"
        shift
        ;;
      --model=*)
        MODEL_OVERRIDE="${1#--model=}"
        ;;
      *)
        CLIENT_ARGS+=("$1")
        ;;
    esac
    shift
  done
}

start_stack() {
  local attempt
  local runtime

  [[ "${START_STACK}" == true ]] || return 0
  runtime="$(env_value LOCALHOST_AI_RUNTIME)"
  runtime="${runtime:-$(env_value LOCAL_AI_RUNTIME)}"
  if [[ -z "${runtime}" ]] && command -v nvidia-smi >/dev/null 2>&1 \
    && nvidia-smi >/dev/null 2>&1; then
    runtime="gpu"
  fi
  if make -C "${STACK_DIR}" test-ollama >/dev/null 2>&1 \
    && make -C "${STACK_DIR}" test-open-webui >/dev/null 2>&1 \
    && { [[ "${runtime}" != "gpu" ]] \
      || docker inspect localhost-ai-ollama --format '{{json .HostConfig.DeviceRequests}}' 2>/dev/null \
        | grep -q 'nvidia'; }; then
    return 0
  fi

  printf 'Iniciando ambiente local de IA (%s)...\n' "${runtime:-cpu}"
  if [[ "${runtime}" == "gpu" ]]; then
    make -C "${STACK_DIR}" up-gpu
  else
    make -C "${STACK_DIR}" up
  fi

  for attempt in $(seq 1 30); do
    if make -C "${STACK_DIR}" test-ollama >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  fail "Ollama não respondeu; consulte: make -C ${STACK_DIR} logs"
}

main() {
  local aider_editor_model
  local general_model
  local local_ai_ca_bundle
  local model
  local opencode_model
  local ollama_port

  parse_args "$@"
  [[ -n "${CLIENT}" ]] || fail "escolha o assistente: localhost.ai --aider ou localhost.ai --opencode"
  resolve_stack_dir

  [[ -f "${STACK_DIR}/docker-compose.yml" && -f "${STACK_DIR}/.env" ]] \
    || fail "ambiente não instalado em ${STACK_DIR}; execute primeiro o instalador"
  command -v make >/dev/null 2>&1 || fail "make não está instalado"
  command -v docker >/dev/null 2>&1 || fail "Docker não está instalado"
  command -v git >/dev/null 2>&1 || fail "Git não está instalado"
  if [[ "${CLIENT}" == "opencode" ]]; then
    command -v opencode >/dev/null 2>&1 || fail "OpenCode não está instalado"
  else
    command -v aider >/dev/null 2>&1 || fail "Aider não está instalado"
  fi
  [[ -d "${PROJECT_DIR}" ]] || fail "diretório não encontrado: ${PROJECT_DIR}"
  git -C "${PROJECT_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || fail "${PROJECT_DIR} não é um repositório Git; entre em um projeto ou use --project"

  PROJECT_DIR="$(cd "${PROJECT_DIR}" && pwd)"
  start_stack

  if [[ -n "${MODEL_OVERRIDE}" ]]; then
    model="${MODEL_OVERRIDE}"
  elif [[ "${CLIENT}" == "opencode" ]]; then
    model="$(env_value OLLAMA_OPENCODE_MODEL_DEFAULT)"
  else
    model="$(env_value OLLAMA_AIDER_MODEL_DEFAULT)"
  fi
  model="${model:-$(env_value OLLAMA_MODEL_DEFAULT)}"
  [[ -n "${model}" ]] || fail "nenhum modelo foi configurado em ${STACK_DIR}/.env"
  general_model="$(env_value OLLAMA_MODEL_DEFAULT)"
  general_model="${general_model:-${model}}"
  aider_editor_model="$(env_value OLLAMA_CODE_MODEL_DEFAULT)"
  aider_editor_model="${aider_editor_model:-${model}}"
  [[ "${general_model}" == */* ]] || general_model="ollama_chat/${general_model}"
  [[ "${aider_editor_model}" == */* ]] || aider_editor_model="ollama_chat/${aider_editor_model}"
  ollama_port="$(env_value OLLAMA_PORT)"
  export OLLAMA_API_BASE="http://localhost:${ollama_port:-11434}"
  local_ai_ca_bundle="$(env_value LOCALHOST_AI_CA_BUNDLE)"
  local_ai_ca_bundle="${local_ai_ca_bundle:-$(env_value LOCAL_AI_CA_BUNDLE)}"
  local_ai_ca_bundle="${local_ai_ca_bundle:-/etc/ssl/certs/ca-certificates.crt}"
  if [[ -r "${local_ai_ca_bundle}" ]]; then
    export SSL_CERT_FILE="${SSL_CERT_FILE:-${local_ai_ca_bundle}}"
    export REQUESTS_CA_BUNDLE="${REQUESTS_CA_BUNDLE:-${local_ai_ca_bundle}}"
    export CURL_CA_BUNDLE="${CURL_CA_BUNDLE:-${local_ai_ca_bundle}}"
  fi

  cd "${PROJECT_DIR}"
  if [[ "${CLIENT}" == "opencode" ]]; then
    opencode_model="${model#ollama/}"
    [[ "${opencode_model}" == */* ]] || opencode_model="ollama/${opencode_model}"
    show_startup_guide "${opencode_model}" "OpenCode (Build)"
    if [[ -n "${MODEL_OVERRIDE}" ]]; then
      exec opencode --model "${opencode_model}" "${CLIENT_ARGS[@]}"
    fi
    exec opencode "${CLIENT_ARGS[@]}"
  fi

  [[ "${model}" == */* ]] || model="ollama_chat/${model}"
  show_startup_guide "${model}" "Aider"
  exec aider \
    --no-check-update \
    --no-show-release-notes \
    --no-browser \
    --model "${model}" \
    --editor-model "${aider_editor_model}" \
    --weak-model "${general_model}" \
    --alias "local-chat:${general_model}" \
    --alias "local-code:${aider_editor_model}" \
    "${CLIENT_ARGS[@]}"
}

main "$@"
